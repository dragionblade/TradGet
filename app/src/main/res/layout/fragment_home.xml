<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F0F8FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header with Gradient -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/gradient_header"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TradGet"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Split fuel. Share rides. Save money."
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:alpha="0.9"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Segmented Toggle Control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_toggle_unselected"
            android:padding="4dp">

            <TextView
                android:id="@+id/togglePassenger"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Passenger"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_toggle_selected" />

            <TextView
                android:id="@+id/toggleRider"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Rider"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#757575"
                android:background="@android:color/transparent" />

        </LinearLayout>

        <!-- Location Input Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:elevation="4dp">

            <!-- From Location -->
            <LinearLayout
                android:id="@+id/fromLocationContainer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    android:tint="#00BCD4" />

                <TextView
                    android:id="@+id/fromLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="From - Current Location"
                    android:paddingStart="12dp"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:textColorHint="#9E9E9E" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E3F2FD"
                android:layout_marginVertical="12dp" />

            <!-- To Location -->
            <LinearLayout
                android:id="@+id/toLocationContainer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_directions"
                    android:tint="#2979FF" />

                <TextView
                    android:id="@+id/toLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Where to?"
                    android:paddingStart="12dp"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:textColorHint="#9E9E9E" />

            </LinearLayout>

        </LinearLayout>

        <!-- Search Ride Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_cyan"
            android:gravity="center"
            android:id="@+id/searchRideBtn"
            android:clickable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/searchRideLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search Ride"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Available Rides Section -->
        <TextView
            android:id="@+id/ridesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:text="Available Rides"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <!-- Loading spinner shown while Firestore query runs -->
        <ProgressBar
            android:id="@+id/ridesProgress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:indeterminateTint="#00BCD4"
            android:visibility="gone" />

        <!-- Empty state -->
        <TextView
            android:id="@+id/noRidesLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:text="No rides found for this route.\nTry a different destination or check back later."
            android:textSize="14sp"
            android:textColor="#9E9E9E"
            android:textAlignment="center"
            android:gravity="center"
            android:visibility="gone" />

        <!-- Dynamic ride cards are added here by HomeFragment -->
        <LinearLayout
            android:id="@+id/dynamicRidesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="100dp" />

    </LinearLayout>

</ScrollView>