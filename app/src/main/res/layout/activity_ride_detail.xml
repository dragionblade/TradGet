<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F0F8FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/gradient_header"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/detailBackBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_card"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ride Details"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginStart="12dp"/>

        </LinearLayout>

        <!-- Rider info card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:elevation="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Avatar circle -->
                <LinearLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_toggle_selected"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/detailRiderInitial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/detailRiderName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rider Name"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#212121"/>

                    <TextView
                        android:id="@+id/detailVehicle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bike"
                        android:textSize="13sp"
                        android:textColor="#757575"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/detailRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.8 ★"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#00BCD4"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Route + stats card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:elevation="4dp"
            android:orientation="vertical">

            <!-- Route -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    android:tint="#00BCD4"/>

                <TextView
                    android:id="@+id/detailFromName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pickup"
                    android:textSize="14sp"
                    android:textColor="#212121"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_marginStart="7dp"
                android:background="#00BCD4"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_directions"
                    android:tint="#2979FF"/>

                <TextView
                    android:id="@+id/detailToName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Drop"
                    android:textSize="14sp"
                    android:textColor="#212121"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E3F2FD"
                android:layout_marginVertical="16dp"/>

            <!-- Stats row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/detailCost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ —"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#00BCD4"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Per person"
                        android:textSize="11sp"
                        android:textColor="#757575"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/detailSeats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#00BCD4"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seats free"
                        android:textSize="11sp"
                        android:textColor="#757575"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/detailTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#00BCD4"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Departure"
                        android:textSize="11sp"
                        android:textColor="#757575"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Status banner (hidden until request is sent) -->
        <LinearLayout
            android:id="@+id/requestStatusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_field"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/requestStatusProgress"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="#00BCD4"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/requestStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waiting for rider to accept…"
                android:textSize="14sp"
                android:textColor="#212121"/>

            <TextView
                android:id="@+id/cancelRequestButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Cancel"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF5252"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"/>

        </LinearLayout>

        <!-- Distance and Fuel Cost Breakdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:elevation="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detailDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distance: —"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#00BCD4"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/detailFuelCostBreakdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fuel cost breakdown"
                android:textSize="12sp"
                android:textColor="#757575"/>

        </LinearLayout>

        <!-- Request Ride Button -->
        <LinearLayout
            android:id="@+id/requestRideBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_button_cyan"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ProgressBar
                android:id="@+id/requestProgress"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="#FFFFFF"
                android:visibility="gone"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/requestBtnLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Request Ride"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
