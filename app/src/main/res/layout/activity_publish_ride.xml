<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F0F8FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/gradient_header"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/publishBackButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_card"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Offer a Ride"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginStart="12dp"/>

        </LinearLayout>

        <!-- Route summary card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:elevation="4dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Route"
                android:textSize="13sp"
                android:textColor="#757575"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    android:tint="#00BCD4"/>

                <TextView
                    android:id="@+id/publishFromName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pickup location"
                    android:textSize="14sp"
                    android:textColor="#212121"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginStart="9dp"
                android:background="#00BCD4"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_directions"
                    android:tint="#2979FF"/>

                <TextView
                    android:id="@+id/publishToName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Drop location"
                    android:textSize="14sp"
                    android:textColor="#212121"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Ride details form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:elevation="4dp"
            android:orientation="vertical">

            <!-- Departure Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Departure Time"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:id="@+id/departureTimeBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:tint="#00BCD4"/>

                <TextView
                    android:id="@+id/departureTimeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tap to select time"
                    android:textSize="14sp"
                    android:textColor="#9E9E9E"
                    android:layout_marginStart="12dp"/>

            </LinearLayout>

            <!-- Vehicle Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vehicle Type"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/vehicleBike"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🏍 Bike"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_toggle_selected"
                    android:layout_marginEnd="4dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/vehicleScooty"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🛵 Scooty"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:background="@drawable/bg_input_field"
                    android:layout_marginHorizontal="4dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/vehicleCar"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🚗 Car"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:background="@drawable/bg_input_field"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

            <!-- Seats Available -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seats Available"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/seatsDecrease"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="−"
                    android:textSize="22sp"
                    android:textColor="#00BCD4"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"/>

                <TextView
                    android:id="@+id/seatsCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="2"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"/>

                <TextView
                    android:id="@+id/seatsIncrease"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="+"
                    android:textSize="22sp"
                    android:textColor="#00BCD4"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"/>

            </LinearLayout>

            <!-- Fuel Price -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fuel Price (₹/L)"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/publishFuelPrice"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:hint="95"
                android:inputType="numberDecimal"
                android:textSize="15sp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E"/>

        </LinearLayout>

        <!-- Distance and Cost Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:elevation="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/distanceDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distance: —"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#00BCD4"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/costDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cost per person: —"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2979FF"/>

        </LinearLayout>

        <!-- Publish button -->
        <LinearLayout
            android:id="@+id/publishRideBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_button_cyan"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ProgressBar
                android:id="@+id/publishProgress"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="#FFFFFF"
                android:visibility="gone"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/publishBtnLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Publish Ride"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
